# Production environment template. Copy to .env on the server and fill in real values:
#
#   cp .env.production.example .env && chmod 600 .env
#
# .env is gitignored and must stay that way. Never commit real credentials.
# Generate every secret below with:  openssl rand -base64 32

# ---------------------------------------------------------------------------
# Domains and TLS
# ---------------------------------------------------------------------------
SITE_DOMAIN=jobsvsai.com
API_DOMAIN=api.jobsvsai.com
# Let's Encrypt sends expiry and problem notices here. Use a mailbox you actually read.
LETSENCRYPT_EMAIL=you@example.com

# Baked into the client bundle at image build time, not read at runtime. Changing these
# requires a rebuild of the frontend image, not just a restart.
NEXT_PUBLIC_SITE_URL=https://jobsvsai.com
NEXT_PUBLIC_API_URL=https://api.jobsvsai.com
# Server-side calls stay on the compose network and never leave the host.
API_INTERNAL_URL=http://backend:8000

# The API refuses browser origins it does not recognise. Only the canonical site origin.
CORS_ORIGINS=https://jobsvsai.com

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_DB=jobsvsai
POSTGRES_USER=jobsvsai
# REPLACE. Must match the password inside DATABASE_URL below.
POSTGRES_PASSWORD=replace-with-openssl-rand-base64-32
DATABASE_URL=postgresql+asyncpg://jobsvsai:replace-with-openssl-rand-base64-32@postgres:5432/jobsvsai

# ---------------------------------------------------------------------------
# Redis / worker
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
QUEUE_NAME=default

# ---------------------------------------------------------------------------
# Internal data console (/admin)
# ---------------------------------------------------------------------------
# Basic auth engages only when ENVIRONMENT=production. With any other value the console is
# open to anyone who can reach it — which is why ENVIRONMENT below is not optional.
ADMIN_USERNAME=admin
# REPLACE. This is the only thing standing in front of the data console.
ADMIN_PASSWORD=replace-with-openssl-rand-base64-32

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
ENVIRONMENT=production
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Backups
# ---------------------------------------------------------------------------
# Where scripts/backup-db.sh writes. Must be on a volume with room for RETENTION_DAYS of
# compressed dumps; the database is ~5 GB raw, roughly 400-700 MB per compressed dump.
BACKUP_DIR=/var/backups/jobsvsai
BACKUP_RETENTION_DAYS=14

# Google Analytics 4. Leave empty to ship without analytics — local development and
# previews should stay empty so they never write into the production property.
# A GA4 measurement ID is not a secret (it is visible in page source), but it is
# environment-specific. Real value belongs in .env, never here. Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# Google AdSense
# ---------------------------------------------------------------------------
# Disabled by default. When NEXT_PUBLIC_ADS_ENABLED is not "true", no
# AdSense script is loaded and no ad containers are rendered.
#
# Before enabling, complete the AdSense setup checklist in reports/ADSENSE_INTEGRATION_V1.md.
# Real publisher ID belongs in .env, never here. Format: ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADS_DEBUG=false
# Individual ad slot IDs created in the Google AdSense console:
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_JOB_PRIMARY=
NEXT_PUBLIC_ADSENSE_SLOT_JOB_SECONDARY=
NEXT_PUBLIC_ADSENSE_SLOT_RANKINGS=
NEXT_PUBLIC_ADSENSE_SLOT_COMPARE=
NEXT_PUBLIC_ADSENSE_SLOT_NEWS_LIST=
NEXT_PUBLIC_ADSENSE_SLOT_NEWS_ARTICLE=

# ---------------------------------------------------------------------------------------
# AI News. Every value below is the SAFE POST-DEPLOY STATE and should not be changed as
# part of a deployment.
#
# Omitting this whole block is also safe — every variable defaults to disabled in code, and
# compose passes unset variables through as empty. It is written out so the knobs are
# discoverable, and so nobody has to read the application to learn that publishing is gated.
#
# Ingestion and generation are controlled SEPARATELY, which is what allows feeds to be
# polled in production while no language-model call is ever made. Enable ingestion first and
# leave generation off for several cycles.
NEWS_INGESTION_ENABLED=false
NEWS_GENERATION_ENABLED=false

# MUST remain false. Publication is editorially controlled; scripts/news-generate.sh refuses
# to run at all when this is true, and the generation service has no path to `published`
# regardless.
NEWS_AUTO_PUBLISH=false

# Deprecated single flag. Leave unset. If set it applies to BOTH pipelines above and is
# overridden by either of them when they are explicitly set.
# NEWS_ENABLED=

# Provider. NEWS_LLM_API_KEY is a secret: set it directly on the host, never in a template.
NEWS_LLM_PROVIDER=null
NEWS_LLM_API_KEY=
NEWS_LLM_MODEL=
NEWS_LLM_TIMEOUT_SECONDS=45

# Generation caps. Sized to what the provider free tier actually sustained (~3 calls per
# session before rate limiting), not to what seemed reasonable. Raise only on a paid tier.
# NEWS_MAX_GENERATIONS_PER_RUN / _PER_DAY are accepted aliases and win when set.
NEWS_GENERATION_BATCH_SIZE=2
NEWS_DAILY_GENERATION_LIMIT=5
# NEWS_MAX_GENERATIONS_PER_RUN=
# NEWS_MAX_GENERATIONS_PER_DAY=

# Ingestion volume controls. Feeds carry years of history — one seeded feed holds over a
# thousand entries — so these are what stop a first run ingesting an entire archive.
# A first manual run needs a WIDER one-off window (--lookback 168); at 48h it will find
# nothing, because first-party AI labs publish every few days.
NEWS_LOOKBACK_HOURS=48
NEWS_MAX_ENTRIES_PER_FEED=40
NEWS_MAX_CANDIDATES_PER_RUN=60
NEWS_FETCH_INTERVAL_MINUTES=120

# Optional. Without BOTH, `cli metrics` reports tokens only. A currency figure derived from
# a guessed rate looks authoritative and is not.
NEWS_LLM_COST_PER_1M_INPUT=
NEWS_LLM_COST_PER_1M_OUTPUT=
