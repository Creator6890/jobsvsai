# Production environment template. Copy to .env on the server and fill in real values:
#
#   cp .env.production.example .env && chmod 600 .env
#
# .env is gitignored and must stay that way. Never commit real credentials.
# Generate every secret below with:  openssl rand -base64 32

# ---------------------------------------------------------------------------
# Domains and TLS
# ---------------------------------------------------------------------------
SITE_DOMAIN=jobsvsai.com
API_DOMAIN=api.jobsvsai.com
# Let's Encrypt sends expiry and problem notices here. Use a mailbox you actually read.
LETSENCRYPT_EMAIL=you@example.com

# Baked into the client bundle at image build time, not read at runtime. Changing these
# requires a rebuild of the frontend image, not just a restart.
NEXT_PUBLIC_SITE_URL=https://jobsvsai.com
NEXT_PUBLIC_API_URL=https://api.jobsvsai.com
# Server-side calls stay on the compose network and never leave the host.
API_INTERNAL_URL=http://backend:8000

# The API refuses browser origins it does not recognise. Only the canonical site origin.
CORS_ORIGINS=https://jobsvsai.com

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_DB=jobsvsai
POSTGRES_USER=jobsvsai
# REPLACE. Must match the password inside DATABASE_URL below.
POSTGRES_PASSWORD=replace-with-openssl-rand-base64-32
DATABASE_URL=postgresql+asyncpg://jobsvsai:replace-with-openssl-rand-base64-32@postgres:5432/jobsvsai

# ---------------------------------------------------------------------------
# Redis / worker
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
QUEUE_NAME=default

# ---------------------------------------------------------------------------
# Internal data console (/admin)
# ---------------------------------------------------------------------------
# Basic auth engages only when ENVIRONMENT=production. With any other value the console is
# open to anyone who can reach it — which is why ENVIRONMENT below is not optional.
ADMIN_USERNAME=admin
# REPLACE. This is the only thing standing in front of the data console.
ADMIN_PASSWORD=replace-with-openssl-rand-base64-32

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
ENVIRONMENT=production
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Backups
# ---------------------------------------------------------------------------
# Where scripts/backup-db.sh writes. Must be on a volume with room for RETENTION_DAYS of
# compressed dumps; the database is ~5 GB raw, roughly 400-700 MB per compressed dump.
BACKUP_DIR=/var/backups/jobsvsai
BACKUP_RETENTION_DAYS=14
