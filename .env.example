# Public URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
API_INTERNAL_URL=http://backend:8000

# PostgreSQL — the development database. NEVER used for pytest.
POSTGRES_DB=jobsvsai
POSTGRES_USER=jobsvsai
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://jobsvsai:change-me@postgres:5432/jobsvsai

# The isolated pytest database. Created by ./scripts/create-test-db.sh and used only by
# ./scripts/run-tests.sh, which sets DATABASE_URL and TEST_DATABASE=true for that run.
# Do not set TEST_DATABASE here: it is the test harness's explicit opt-in, and leaving it
# unset is what stops a stray `pytest` from reaching the development database.
TEST_POSTGRES_DB=jobsvsai_test

# Redis / worker
REDIS_URL=redis://redis:6379/0
QUEUE_NAME=default

# Internal admin protection (required in production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-too

# Google Analytics 4. Leave empty to ship without analytics — local development and
# previews should stay empty so they never write into the production property.
# A GA4 measurement ID is not a secret (it is visible in page source), but it is
# environment-specific. Real value belongs in .env, never here. Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
