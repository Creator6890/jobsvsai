# Public URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
API_INTERNAL_URL=http://backend:8000

# PostgreSQL — the development database. NEVER used for pytest.
POSTGRES_DB=jobsvsai
POSTGRES_USER=jobsvsai
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://jobsvsai:change-me@postgres:5432/jobsvsai

# The isolated pytest database. Created by ./scripts/create-test-db.sh and used only by
# ./scripts/run-tests.sh, which sets DATABASE_URL and TEST_DATABASE=true for that run.
# Do not set TEST_DATABASE here: it is the test harness's explicit opt-in, and leaving it
# unset is what stops a stray `pytest` from reaching the development database.
TEST_POSTGRES_DB=jobsvsai_test

# Redis / worker
REDIS_URL=redis://redis:6379/0
QUEUE_NAME=default

# Internal admin protection (required in production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-too

# Google Analytics 4. Leave empty to ship without analytics — local development and
# previews should stay empty so they never write into the production property.
# A GA4 measurement ID is not a secret (it is visible in page source), but it is
# environment-specific. Real value belongs in .env, never here. Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# AI News. Ingestion and generation are controlled SEPARATELY, so feeds can be polled in
# production while no language-model call is ever made. Both default to false.
#
#   NEWS_INGESTION_ENABLED=true  + NEWS_GENERATION_ENABLED=false
#     -> fetch, normalise, deduplicate and store candidates. No provider call, no articles.
#
# NEWS_AUTO_PUBLISH must stay false — publication is manually approved, always.
# Never commit a real API key: NEWS_LLM_API_KEY belongs in .env only.
NEWS_INGESTION_ENABLED=false
NEWS_GENERATION_ENABLED=false
# Deprecated single flag. Leave unset. If set, it applies to BOTH pipelines and is
# overridden by either split flag above. Retained only for backwards compatibility.
# NEWS_ENABLED=
NEWS_LLM_PROVIDER=null
NEWS_LLM_API_KEY=
NEWS_LLM_MODEL=
# Generation limits. These two names are canonical; NEWS_MAX_GENERATIONS_PER_RUN and
# NEWS_MAX_GENERATIONS_PER_DAY are accepted aliases for the same caps and win when set.
# Defaults are sized to what the free tier actually sustained (~3 calls per session before
# 429s), not to what seemed reasonable. Raise only on a paid tier.
NEWS_DAILY_GENERATION_LIMIT=5
NEWS_GENERATION_BATCH_SIZE=2
# Aliases for the two caps above. Leave unset; they win when set.
# NEWS_MAX_GENERATIONS_PER_RUN=
# NEWS_MAX_GENERATIONS_PER_DAY=
# A failing provider call occupies 80-140s: this timeout is multiplied by up to three
# attempts plus backoff. Shortening it does not shorten a failing batch proportionally.
NEWS_LLM_TIMEOUT_SECONDS=45

# Optional. Without both, `metrics` reports tokens only — a currency figure from a guessed
# rate looks authoritative and is not.
NEWS_LLM_COST_PER_1M_INPUT=
NEWS_LLM_COST_PER_1M_OUTPUT=
NEWS_AUTO_PUBLISH=false

# Phase 2 ingestion. Feeds carry years of history (the OpenAI feed alone holds >1000
# entries), so the lookback window and per-feed cap are what stop a first run ingesting an
# entire archive. Do not raise them casually.
NEWS_FETCH_INTERVAL_MINUTES=120
NEWS_LOOKBACK_HOURS=48
NEWS_MAX_ENTRIES_PER_FEED=40
NEWS_MAX_CANDIDATES_PER_RUN=60
