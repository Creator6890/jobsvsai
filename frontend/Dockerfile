FROM node:22-alpine AS dependencies
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

FROM node:22-alpine AS build
WORKDIR /app
COPY --from=dependencies /app/node_modules ./node_modules
COPY frontend/ ./
ARG NEXT_PUBLIC_SITE_URL=http://localhost:3000
ARG NEXT_PUBLIC_API_URL=http://localhost:8000
# Empty by default: a build that is not given a measurement ID ships without analytics
# rather than inheriting someone else's property.
ARG NEXT_PUBLIC_GA_MEASUREMENT_ID=
ARG NEXT_PUBLIC_ADS_ENABLED=false
ARG NEXT_PUBLIC_ADSENSE_CLIENT_ID=
ARG NEXT_PUBLIC_ADS_DEBUG=false
ARG NEXT_PUBLIC_ADSENSE_SLOT_HOME=
ARG NEXT_PUBLIC_ADSENSE_SLOT_JOB_PRIMARY=
ARG NEXT_PUBLIC_ADSENSE_SLOT_JOB_SECONDARY=
ARG NEXT_PUBLIC_ADSENSE_SLOT_RANKINGS=
ARG NEXT_PUBLIC_ADSENSE_SLOT_COMPARE=
ARG NEXT_PUBLIC_ADSENSE_SLOT_NEWS_LIST=
ARG NEXT_PUBLIC_ADSENSE_SLOT_NEWS_ARTICLE=
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL \
    NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_GA_MEASUREMENT_ID=$NEXT_PUBLIC_GA_MEASUREMENT_ID \
    NEXT_PUBLIC_ADS_ENABLED=$NEXT_PUBLIC_ADS_ENABLED \
    NEXT_PUBLIC_ADSENSE_CLIENT_ID=$NEXT_PUBLIC_ADSENSE_CLIENT_ID \
    NEXT_PUBLIC_ADS_DEBUG=$NEXT_PUBLIC_ADS_DEBUG \
    NEXT_PUBLIC_ADSENSE_SLOT_HOME=$NEXT_PUBLIC_ADSENSE_SLOT_HOME \
    NEXT_PUBLIC_ADSENSE_SLOT_JOB_PRIMARY=$NEXT_PUBLIC_ADSENSE_SLOT_JOB_PRIMARY \
    NEXT_PUBLIC_ADSENSE_SLOT_JOB_SECONDARY=$NEXT_PUBLIC_ADSENSE_SLOT_JOB_SECONDARY \
    NEXT_PUBLIC_ADSENSE_SLOT_RANKINGS=$NEXT_PUBLIC_ADSENSE_SLOT_RANKINGS \
    NEXT_PUBLIC_ADSENSE_SLOT_COMPARE=$NEXT_PUBLIC_ADSENSE_SLOT_COMPARE \
    NEXT_PUBLIC_ADSENSE_SLOT_NEWS_LIST=$NEXT_PUBLIC_ADSENSE_SLOT_NEWS_LIST \
    NEXT_PUBLIC_ADSENSE_SLOT_NEWS_ARTICLE=$NEXT_PUBLIC_ADSENSE_SLOT_NEWS_ARTICLE \
    NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nextjs
COPY --from=build --chown=nextjs:nodejs /app/public ./public
COPY --from=build --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=build --chown=nextjs:nodejs /app/.next/static ./.next/static
USER nextjs
EXPOSE 3000
CMD ["node", "server.js"]
